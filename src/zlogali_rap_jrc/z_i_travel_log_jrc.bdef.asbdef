managed;
//strict ( 2 ); //Uncomment this line in order to enable strict mode 2. The strict mode has two variants (strict(1), strict(2)) and is prerequisite to be future proof regarding syntax and to be able to release your BO.

define behavior for Z_I_TRAVEL_LOG_JRC alias Travel
implementation in class ZBP_I_TRAVEL_LOG_JRC unique
persistent table ztravel_log_jrc
lock master
authorization master ( instance )
etag master last_changed_at
{
  // administrative fields: read only
  field ( readonly ) last_changed_at, last_changed_by, created_at, created_by;
  // mandatory fields that are required to create a travel
  field ( mandatory : create ) travel_id, agency_id, overall_status, booking_fee, currency_code;
  // dynamic field control
  field ( features : instance ) travel_id, overall_status;
  create;
  update;
  delete;
  // validations
  validation validateCustomer on save { create; field customer_id; }
  validation validateDates on save { create; field begin_date, end_date; }
  validation validateStatus on save
  { create; field overall_status; }
  //actions
  action ( features : instance ) acceptTravel result [1] $self;
  action ( features : instance ) rejectTravel result [1] $self;
  action createTravelByTemplate result [1] $self;
  association _Booking { create ( features : instance ); }
  mapping for ztravel_log_jrc corresponding;
}

define behavior for Z_I_BOOKING_LOG_JRC alias Booking
implementation in class ZBP_I_BOOKING_LOG_JRC unique
persistent table zbooking_log_jrc
lock dependent by _Travel
authorization dependent by _Travel
etag master last_change_at
{
  // static fields control
  field ( readonly ) travel_id;
  field ( mandatory : create ) booking_id, carrier_id, connection_id, flight_date, booking_status;
  update;
  delete;
  //validations
  validation validateStatus on save
  { create; field booking_status; }
  //determinations
  determination calculateTotalFlightPrice on modify
  { field flight_price, currency_code; }
  association _BookingSupplement { create ( features : instance ); }
  association _Travel { }
  mapping for zbooking_log_jrc corresponding;
}

define behavior for Z_I_BOOKSUPPL_LOG_JRC alias Supplement
implementation in class ZBP_I_BOOKSUPPL_LOG_JRC unique
with unmanaged save
lock dependent by _Travel
authorization dependent by _Travel
etag master last_changed_at
{
  // Static Field Control
  field ( readonly ) travel_id, booking_id;
  field ( mandatory ) supplement_id, price;

  update;
  delete;
  //Determination
  determination calculateTotalSupplPrice on modify { field price, currency; }

  //  field ( readonly ) TravelId, BookingId, BookingSupplementId;
  association _Travel;
  mapping for zlog_log_jrc corresponding;
}