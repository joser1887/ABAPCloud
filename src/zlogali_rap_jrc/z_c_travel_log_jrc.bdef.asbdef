projection;
strict ( 2 );
use draft;

define behavior for Z_C_TRAVEL_LOG_jrc alias TravelProcessor
use etag
{
  use create;
  use update;
  use delete;

  use action validateCustomerID;
  use action validateAgencyID;
  use action validateDatesRange;
//  use action acceptTravel;
//  use action rejectTravel;
  use action deductDiscount;
  use action createTravelByTemplate;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Booking { create; with draft; }
}

define behavior for Z_c_BOOKING_LOG_JRC alias BookingProcessor
{
  use update;
  use delete;

  use action validateFlightCost;

  use association _BookingSupplement { create; with draft; }
  use association _Travel { with draft; }
}

define behavior for Z_C_BOOKSUPPL_LOG_JRC alias SupplementProcessor
{
  use update;
  use delete;

  use action validateSupplementPrice;
  use action validateCurrencyEfec;
  use action validatePriceEfec;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}