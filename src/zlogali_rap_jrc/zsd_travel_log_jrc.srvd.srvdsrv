@EndUserText.label: 'Travel'
define service ZSD_TRAVEL_LOG_JRC {
  expose Z_C_TRAVEL_LOG_jrc    as Travel;
  expose Z_c_BOOKING_LOG_JRC   as Booking;
  expose Z_C_BOOKSUPPL_LOG_JRC as BookingSupplement;
  expose /DMO/I_Supplement     as Supplement;
  expose /DMO/I_SupplementText as SupplementText;
  expose /DMO/I_Customer       as Passager;
  expose /DMO/I_Agency         as Agency;
  expose /DMO/I_Carrier        as Airline;
  expose /DMO/I_Connection     as FligthConnection;
  expose /DMO/I_Flight         as Flight;
  expose I_Currency            as Currency;
  expose I_Country             as Country;
}